(include "./notification_center/quick_glance/quick_glance.yuck")
(include "./notification_center/notifications/notifications.yuck")
(include "./notification_center/calendar/calendar.yuck")
(include "./notification_center/agenda/agenda.yuck")

(defwidget notification_center []
  (box :class "center-wrapper" 
    :orientation "h" 
    :space-evenly true 
    :spacing 16 
    (box :class "left-column" :orientation "v" :space-evenly false
      (quick_glance_widget)
      (notifications_widget))
    
    (box :class "right-column" :orientation "v" :space-evenly false
      (calendar_widget)
      (agenda_widget))))

