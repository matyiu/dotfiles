(include "./system_menu/wifi/wifi_item.yuck")
(include "./system_menu/wifi/wifi_form.yuck")

(defpoll wifi_status :interval "500ms" "nmcli -t -f WIFI g")
(defpoll wifi_label :interval "500ms" "$HOME/.scripts/eww-wifi-status.sh")
(defpoll wifi_networks :interval "500ms" "$HOME/.scripts/eww-wifi-networks.py")

(defvar wifi_show_list false)
(defvar wifi_selected "")
(defvar wifi_connecting false)

(defwidget wifi_widget []
  (box :orientation "v" :space-evenly false :spacing 8 :hexpand true
    (box :class "wifi-group" :space-evenly false :spacing 4 :hexpand true
      (button :class "toggle-tile wifi-toggle ${wifi_status == 'enabled' ? 'active' : ''}" :hexpand true
              :onclick "nmcli r wifi ${wifi_status == 'enabled' ? 'off' : 'on'}"
        (box :space-evenly false :spacing 10
          (label :class "tile-icon" :text "󰤨")
          (label :class "tile-label" :text "${wifi_connecting ? 'Connecting...' : wifi_label}" :hexpand true :halign "start" :truncate true)))
      (button :class "wifi-arrow ${wifi_show_list ? 'active' : ''}" 
              :onclick "if [ '${wifi_show_list}' = 'true' ]; then eww update wifi_show_list=false; else eww update bt_show_list=false wifi_show_list=true wifi_selected=''; fi"
        (label :text "${wifi_show_list ? '󰅃' : '󰅀'}")))

    (revealer :transition "slideup" :reveal wifi_show_list :duration "200ms"
      (box :class "wifi-list-box" :orientation "v" :space-evenly false :spacing 6 :hexpand true
        (scroll :class "wifi-scroll" :vscroll true :hscroll false :height 300
          (box :orientation "v" :space-evenly false :spacing 4
            (for net in wifi_networks
              (wifi_item :net net :active {wifi_selected ? wifi_selected.ssid : wifi_label}))))
        (wifi_form :selected wifi_selected)))))
