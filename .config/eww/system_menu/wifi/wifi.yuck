(defpoll wifi_status :interval "3s" "nmcli -t -f WIFI g")
(defpoll wifi_networks :interval "999999s" "$HOME/.scripts/eww-wifi-networks.sh")

(defvar wifi_show_list false)
(defvar wifi_selected "")
(defvar wifi_password "")
(defvar wifi_remember false)

(defwidget wifi_widget []
  (box :orientation "v" :space-evenly false :spacing 8 :hexpand true
    (box :class "wifi-group" :space-evenly false :spacing 4 :hexpand true
      (button :class "toggle-tile wifi-toggle ${wifi_status == 'enabled' ? 'active' : ''}" :hexpand true
              :onclick "nmcli r wifi ${wifi_status == 'enabled' ? 'off' : 'on'}"
        (box :space-evenly false :spacing 10
          (label :class "tile-icon" :text "󰤨")
          (label :class "tile-label" :text "Wi-Fi" :hexpand true :halign "start")))
      (button :class "wifi-arrow ${wifi_show_list ? 'active' : ''}" 
              :onclick "if [ '${wifi_show_list}' = 'true' ]; then eww update wifi_show_list=false wifi_selected=\"\" wifi_password=\"\" wifi_remember=false; else eww update bt_show_list=false; eww update wifi_show_list=true wifi_selected=\"\" wifi_password=\"\" wifi_remember=false; eww poll wifi_networks; fi"
        (label :text "${wifi_show_list ? '󰅃' : '󰅀'}")))
    (revealer :transition "slideup" :reveal wifi_show_list :duration "200ms"
      (box :class "wifi-list-box" :orientation "v" :space-evenly false :spacing 6 :hexpand true
        (scroll :class "wifi-scroll" :vscroll true :hscroll false :height 160
          (box :orientation "v" :space-evenly false :spacing 4
            (for net in wifi_networks
              (box :orientation "v" :space-evenly false :spacing 4
                (button :class "wifi-net ${net.inuse ? 'active' : ''}"
                        :onclick "eww update wifi_selected='${net.ssid}' wifi_password='' wifi_remember=false; rm -f /tmp/eww-wifi-pass /tmp/eww-wifi-pass-cur"
                  (box :space-evenly false :spacing 10
                    (label :class "wifi-net-icon" :text "${net.inuse ? '󰤨' : '󰤯'}")
                    (box :orientation "v" :space-evenly false :hexpand true
                      (label :class "wifi-net-name" :text "${net.ssid}" :halign "start" :truncate true)
                      (label :class "wifi-net-sec" :text "${net.security == '--' ? 'Abierta' : net.security}" :halign "start" :truncate true))
                    (label :class "wifi-net-sig" :text "${net.signal}")))
                (box :orientation "v" :space-evenly false :spacing 6 :visible {wifi_selected == net.ssid} :hexpand true
                  (box :class "wifi-pass-box" :orientation "v" :space-evenly false :spacing 8 :hexpand true
                    (input :class "wifi-pass-input" :hexpand true
                           :password true
                           :value wifi_password
                           :onchange "$HOME/.scripts/eww-wifi-pass-debounce.sh '{}'"
                           :onaccept "/bin/sh -c '$HOME/.scripts/eww-wifi-connect.sh \"${net.ssid}\" \"${wifi_password}\" ${wifi_remember}' && ${EWW_CMD} update wifi_selected=\"\"")
                    (box :orientation "v" :space-evenly false :spacing 8
                      (box :space-evenly false :spacing 6 :halign "start"
                        (checkbox :class "wifi-rem"
                                  :checked wifi_remember
                                  :onchecked "${EWW_CMD} update wifi_remember=true"
                                  :onunchecked "${EWW_CMD} update wifi_remember=false")
                        (label :text "Recordar"))
                      (button :class "wifi-connect" :halign "fill"
                              :onclick "/bin/sh -c '$HOME/.scripts/eww-wifi-connect.sh \"${net.ssid}\" \"${wifi_password}\" ${wifi_remember}' && ${EWW_CMD} update wifi_selected=\"\""
                        (label :text "Conectar")))))))))))))
