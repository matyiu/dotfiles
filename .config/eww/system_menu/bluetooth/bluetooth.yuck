(defpoll bt_status :interval "3s" "bluetoothctl show | grep -q 'Powered: yes' && echo on || echo off")
(defpoll bt_devices :interval "5s" "$HOME/.scripts/eww-bt-devices.sh")

(defvar bt_show_list false)

(defwidget bluetooth_widget []
  (box :orientation "v" :space-evenly false :spacing 8
    (box :class "bt-group" :space-evenly false :spacing 4
      (button :class "toggle-tile bt-toggle ${bt_status == 'on' ? 'active' : ''}" :hexpand true
              :onclick "bluetoothctl power ${bt_status == 'on' ? 'off' : 'on'}"
        (box :space-evenly false :spacing 10
          (label :class "tile-icon" :text "󰂯")
          (label :class "tile-label" :text "Bluetooth" :hexpand true :halign "start")))
      (button :class "bt-arrow ${bt_show_list ? 'active' : ''}" 
              :onclick "if [ '${bt_show_list}' = 'true' ]; then eww update bt_show_list=false; else eww update wifi_show_list=false wifi_selected=\"\" wifi_password=\"\" wifi_remember=false; eww update bt_show_list=true; fi"
        (label :text "${bt_show_list ? '󰅃' : '󰅀'}")))
    (revealer :transition "slideup" :reveal bt_show_list :duration "200ms"
      (box :class "bt-list-box" :orientation "v" :space-evenly false :spacing 6
        (scroll :class "bt-scroll" :vscroll true :hscroll false :height 160
          (box :orientation "v" :space-evenly false :spacing 4
            (for device in bt_devices
              (button :class "bt-device ${device.connected ? 'connected' : device.paired ? 'paired' : 'unpaired'}"
                      :onclick "$HOME/.scripts/eww-bt-action.sh '${device.mac}'"
                (box :space-evenly false :spacing 10
                  (label :class "bt-device-icon" :text "${device.connected ? '󰂱' : '󰂯'}")
                  (box :orientation "v" :space-evenly false :hexpand true
                    (label :class "bt-device-name" :text "${device.name}" :halign "start" :truncate true)
                    (label :class "bt-device-status" :text "${device.connected ? 'Conectado' : device.paired ? 'Emparejado' : 'Nuevo'}" :halign "start" :truncate true))
                  (label :class "bt-device-arrow" :text "󰅂"))))))))))
