(defpoll current_volume :interval "1s" "pamixer --get-volume || echo 50")
(defpoll current_brightness :interval "1s" "brightnessctl g | awk '{print int($1/255*100)}' || echo 50")

(include "./system_menu/bluetooth/bluetooth.yuck")
(include "./system_menu/wifi/wifi.yuck")

(defwidget system_menu_widget []
  (box :class "system-menu-wrapper" :orientation "v" :space-evenly false :spacing 14
    
    (box :class "menu-header" :space-evenly false :spacing 10
      (box :class "battery-badge" :space-evenly false :spacing 6 :hexpand true
        (label :class "icon" :text "󰁹")
        (label :text "${EWW_BATTERY.BAT1.capacity}%"))
      (button :class "action-btn" :onclick "betterlockscreen -l" (label :text "󰌾"))
      (button :class "action-btn power" :onclick "$HOME/.scripts/rofi-power-menu.sh" (label :text "")))

    (box :class "sliders-box" :orientation "v" :space-evenly false :spacing 10
      (box :class "slider-row" :space-evenly false :spacing 12
        (label :class "slider-icon" :text "󰕾")
        (scale :class "slider-scale" 
               :hexpand true 
               :min 0 :max 101 
               :value current_volume 
               :onchange "pamixer --set-volume {}"))
      (box :class "slider-row" :space-evenly false :spacing 12
        (label :class "slider-icon" :text "󰃠")
        (scale :class "slider-scale" 
               :hexpand true 
               :min 5 :max 101 
               :value current_brightness 
               :onchange "brightnessctl s {}%")))

    (box :class "toggles-grid" :orientation "v" :space-evenly false :spacing 8
      (box :class "toggle-row" :space-evenly true :spacing 8
        (wifi_widget)
        (bluetooth_widget))

      (box :class "toggle-row" :space-evenly true :spacing 8
        (button :class "toggle-tile" :onclick "$HOME/.scripts/rofi-wifi-menu.sh &"
          (box :space-evenly false :spacing 10
            (label :class "tile-icon" :text "󰈀")
            (label :class "tile-label" :text "Redes" :hexpand true :halign "start")))))))

(defwindow system_menu_closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "fg"
  :focusable false
  (eventbox :onclick "eww close system_menu_closer && eww close system_menu && eww update bt_show_list=false wifi_show_list=false wifi_selected=\"\" wifi_password=\"\" wifi_remember=false"))

(defwindow system_menu
  :monitor 0
  :geometry (geometry :x "-30px" :y "-52px" :anchor "bottom right" :width "500px")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  (system_menu_widget))
