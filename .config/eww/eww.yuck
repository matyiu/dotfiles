(include "./common/closer/closer.yuck")
(include "./notification_center/notification_center.yuck")
(include "./system_menu/system_menu.yuck")

(defwindow notification_center_closer
  :monitor 0
  :geometry (geometry :width "100%" :height "100%")
  :stacking "bg"
  :focusable false
  :vm-ignore true
  (closer :window "notification_center"))

(defwindow notification_center
  :monitor 0
  :geometry (geometry :x "0"
                      :y "-58"
                      :width "1200px"
                      :anchor "bottom center")
  :stacking "fg"
  :windowtype "normal"
  :wm-ignore true
  (notification_center))
